[{"name":"好感度進度條","category":"","enabled":1,"isHtmlTemplate":true,"pattern":"<affection>([\\s\\S]*?)<\\/affection>","flags":"g","replacement":"","htmlTemplate":"<div class=\"rg-aff-card\">\n  <div class=\"rg-aff-name\">{{1.對象}}</div>\n  <div class=\"rg-aff-bar\"><div class=\"rg-aff-fill\" style=\"width:{{1.值}}%\"></div></div>\n  <div class=\"rg-aff-num\">{{1.值}}/100</div>\n</div>","cssScope":".rg-aff-card{display:flex;align-items:center;gap:8px;padding:6px 10px;background:rgba(0,0,0,.04);border-radius:6px;font-size:12px;margin:4px 0}\n.rg-aff-name{font-weight:700}\n.rg-aff-bar{flex:1;height:6px;background:rgba(0,0,0,.12);border-radius:3px;overflow:hidden}\n.rg-aff-fill{height:100%;background:#222;transition:width .3s}\n.rg-aff-num{font-family:monospace;opacity:.7}","aiPrompt":"When character relationship value changes meaningfully, output:\n<affection>對象:用戶名|值:0-100整數</affection>\n\n- Only emit when the value actually moves (don't spam every reply)\n- 值 is the current cumulative score, not a delta\n- Place at end of reply","parseMode":"kv","renderMode":"inline","scope":"global","characterIds":[],"scenes":["chat"],"role":"ai","applyOnDisplay":1,"applyOnPrompt":0,"minDepth":null,"maxDepth":null,"trim":0,"order":0,"createdAt":1790701648537,"updatedAt":1790756145204,"_id":1},{"name":"心聲卡片","category":"","enabled":0,"isHtmlTemplate":true,"pattern":"<心聲>([\\s\\S]*?)<\\/心聲>","flags":"g","replacement":"","htmlTemplate":"<div class=\"rg-inner-voice\">💭 {{$1}}</div>","cssScope":".rg-inner-voice{padding:8px 12px;background:rgba(0,0,0,.04);border-left:3px solid #888;border-radius:6px;font-style:italic;margin:6px 0;color:#666}","aiPrompt":"When you have an internal thought your character would NOT say out loud, wrap it like:\n<心聲>actual inner thought here</心聲>\n\n- Place it BEFORE the spoken/action text\n- Keep it short (1 sentence)\n- Use sparingly — only when there's a real gap between thought and action\n- Skip the tag entirely when not needed","parseMode":"text","renderMode"